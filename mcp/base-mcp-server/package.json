{
	"name": "randomuser-mcp-server",
	"version": "1.0.0",
	"description": "A minimal MCP server demonstrating how to build MCP servers with the randomuser.me API",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "tsx --watch src/server.ts",
		"start": "node dist/server.js",
		"devtunnel:login": "devtunnel user login -d",
		"devtunnel:run": "devtunnel host -p 3000 -a",
		"inspect": "npx @modelcontextprotocol/inspector tsx src/server.ts"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"randomuser",
		"tutorial"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.0.4",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^20.12.7",
		"tsx": "^4.7.2",
		"typescript": "^5.4.5"
	}
}