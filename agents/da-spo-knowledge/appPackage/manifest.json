{
	"$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.27/MicrosoftTeams.schema.json",
	"manifestVersion": "1.27",
	"version": "1.0.0",
	"id": "${{TEAMS_APP_ID}}",
	"developer": {
        "name": "GuidoZam",
        "websiteUrl": "https://iamguidozam.blog",
        "privacyUrl": "https://iamguidozam.blog/privacy",
        "termsOfUseUrl": "https://iamguidozam.blog/term-of-use"
    },
	"icons": {
		"color": "color.png",
		"outline": "outline.png"
	},
	"name": {
		"short": "MCS licensing${{APP_NAME_SUFFIX}}",
		"full": "Full name for MCS licensing${{APP_NAME_SUFFIX}}"
	},
	"description": {
		"short": "Short description for MCS licensing${{APP_NAME_SUFFIX}}",
		"full": "Full description for MCS licensing${{APP_NAME_SUFFIX}}"
	},
	"accentColor": "#FFFFFF",
	"supportsChannelFeatures": "tier1",
	"composeExtensions": [],
	"permissions": ["identity", "messageTeamMembers"],
	"copilotAgents": {
		"declarativeAgents": [
			{
				"id": "declarativeAgent",
				"file": "declarativeAgent.json"
			}
		]
	},
	"validDomains": []
}